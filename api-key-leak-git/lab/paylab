#!/usr/bin/env python3
"""paylab: Ana's command-line tool for her payment account (P060 lab; real providers have the same
buttons in their dashboards). Signs in with the account token in ~/.config/paylab/token, never in Git.
  paylab keys                     list API keys, when and where each was last used
  paylab log KEY_ID               every request made with that key
  paylab roll KEY_ID --save FILE  revoke the key now, write a new one into FILE
"""
import json
import pathlib
import sys
import urllib.request

API = "http://payments"
TOKEN = (pathlib.Path.home() / ".config/paylab/token").read_text().strip()


def call(path, method="GET"):
    req = urllib.request.Request(API + path, method=method, headers={"X-Account-Token": TOKEN})
    with urllib.request.urlopen(req) as r:
        return json.load(r)


args = sys.argv[1:]
if args == ["keys"]:
    print(f"{'ID':<10}{'KEY':<17}{'STATUS':<9}{'LAST USED':<11}{'FROM'}")
    for k in call("/admin/keys")["keys"]:
        status = "revoked" if k["revoked"] else "active"
        print(f"{k['id']:<10}{'kp_live_...' + k['hint']:<17}{status:<9}{k['last_used'] or 'never':<11}{k['last_from'] or ''}")
elif len(args) == 2 and args[0] == "log":
    print(f"{'TIME':<10}{'FROM':<15}{'REQUEST':<19}RESULT")
    for e in call(f"/admin/log?key={args[1]}")["log"]:
        print(f"{e['time']:<10}{e['from']:<15}{e['request']:<19}{e['status']}")
elif len(args) == 4 and args[0] == "roll" and args[2] == "--save":
    r = call(f"/admin/keys/{args[1]}/roll", "POST")
    path = pathlib.Path(args[3])
    path.write_text(f"PAYMENTS_API_KEY={r['new']['secret']}\n")
    print(f"Revoked {r['revoked']}: it stops working now.")
    print(f"New key {r['new']['id']} (kp_live_...{r['new']['secret'][-4:]}) saved to {path}")
else:
    sys.exit(__doc__)
