#!/usr/bin/env python3
"""jwt-extend TOKEN SECONDS (lab only): move a token's exp later without the secret. The header and signature are
copied unchanged, as anyone without the secret would have to: the server should refuse the result."""
import base64
import json
import sys

head, payload, sig = sys.argv[1].split(".")
claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
claims["exp"] += int(sys.argv[2])
new = base64.urlsafe_b64encode(json.dumps(claims, separators=(",", ":")).encode()).rstrip(b"=").decode()
print(f"{head}.{new}.{sig}")
