#!/usr/bin/env bash
# What OpenRouter knows about this key: free tier or not, its spending limit, and today's free-model requests.
curl -s https://openrouter.ai/api/v1/key -H "Authorization: Bearer $OPENROUTER_API_KEY" | jq -r '.data |
  "free tier:            \(.is_free_tier)",
  "spending limit:       $\(.limit)",
  "free requests today:  \(.free_model_daily_requests.used) of \(.free_model_daily_requests.limit)"'
