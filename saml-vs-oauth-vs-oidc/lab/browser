#!/usr/bin/env python3
"""A real Chromium browser, driven from the command line, standing in for Ana at her laptop.

  browser open URL    open the address and follow the trip: every page the browser loads is printed with its real
                      status code. On Maple ID's own sign-in page it types Ana's user name and password (she'd type
                      them; her password is in ~/.maple-password and is typed only on id.maple.test). When Maple ID
                      asks whether an app may have something, it prints the question and clicks Yes.

Cookies are kept between runs (~/.browser-state.json), as a browser left open would keep them. With SHOTS set to a
folder, the pages shown in the video are saved there as pictures (browser_shots.py).
"""
import os
import sys
import urllib.parse

from browser_shots import Shots

STATE = os.path.expanduser("~/.browser-state.json")
SHOTS = os.environ.get("SHOTS")


def short(url):
    u = urllib.parse.urlparse(url)
    return u.netloc + u.path


def text(loc):
    return " ".join(loc.inner_text().split())


def main(argv):
    if len(argv) != 2 or argv[0] != "open":
        sys.exit("usage: browser open URL")
    url = argv[1]
    u = urllib.parse.urlparse(url)
    name = "-".join(x for x in (u.netloc.split(".")[0], u.path.strip("/")) if x)
    kw = {"storage_state": STATE} if os.path.exists(STATE) else {}
    with Shots(SHOTS or "/tmp/noshots", **kw) as s:
        page = s.page

        def seen(resp):
            req = resp.request
            if req.is_navigation_request() and req.frame == page.main_frame:
                print(f"  {resp.status}  {req.method:<4}  {short(resp.url)}", flush=True)

        page.on("response", seen)
        print(f"browser: opens {short(url)}", flush=True)
        page.goto(url)
        def settle():
            """Wait until the browser has left Maple ID, or Maple ID shows a page that needs an answer."""
            for _ in range(150):
                page.wait_for_timeout(100)
                try:
                    if urllib.parse.urlparse(page.url).netloc != "id.maple.test":
                        page.wait_for_load_state()
                        if urllib.parse.urlparse(page.url).netloc != "id.maple.test":
                            return "left"
                    for sel, what in (("#username", "signin"), ("button[name=accept]", "consent"),
                                      ("#kc-error-message", "error")):
                        if page.locator(sel).count() and page.locator(sel).first.is_visible():
                            return what
                except Exception:
                    pass          # mid-navigation
            raise SystemExit("browser: stuck on " + page.url)

        for _ in range(4):
            what = settle()
            if what == "left":
                break
            # Maple ID's pages are small in a wide window: zoom the page in, as Ctrl-plus would, so they can be read.
            page.evaluate("document.documentElement.style.zoom = '1.55'")
            page.locator("#kc-header-wrapper").evaluate(
                "e => window.scrollTo(0, e.getBoundingClientRect().top + window.scrollY - 28)")
            if what == "signin":
                print("page:    Maple ID's own sign-in page; types ana's user name and password there", flush=True)
                page.fill("#username", "ana")
                page.fill("#password", open(os.path.expanduser("~/.maple-password")).read().strip())
                if SHOTS:
                    s.shot(f"{name}-signin", url=page.url.split("?")[0],
                           boxes={"brand": "#kc-header-wrapper", "title": "#kc-page-title", "user": "#username",
                                  "password": "#password", "button": "#kc-login"})
                page.click("#kc-login")
                page.locator("#username").wait_for(state="detached", timeout=15000)
            elif what == "consent":
                asks = [text(li) for li in page.locator("#kc-oauth li").all()]
                print(f"page:    Maple ID asks: {text(page.locator('#kc-oauth h3').first)} "
                      f"{', '.join(a for a in asks if a)}", flush=True)
                if SHOTS:
                    s.shot(f"{name}-consent", url=page.url.split("?")[0],
                           boxes={"brand": "#kc-header-wrapper", "title": "#kc-page-title", "ask": "#kc-oauth h3",
                                  "list": "#kc-oauth ul", "yes": "button[name=accept]",
                                  "no": "button[name=cancel]"})
                print("browser: clicks Yes", flush=True)
                page.click("button[name=accept]")
                page.locator("button[name=accept]").wait_for(state="detached", timeout=15000)
            else:
                print(f"page:    {text(page.locator('#kc-error-message'))}")
                break
        page.wait_for_load_state()
        shown = [text(page.locator(sel).first) for sel in ("#h", "main p") if page.locator(sel).count()]
        print(f"page:    {short(page.url)}: {'. '.join(t for t in shown if t)}")
        if SHOTS and page.locator("#h").count():
            boxes = {"heading": "#h"}
            for k in ("who", "count"):
                if page.locator("#" + k).count():
                    boxes[k] = "#" + k
            s.shot(f"{name}-done", url=page.url.split("?")[0], boxes=boxes)
        s._ctx.storage_state(path=STATE)


if __name__ == "__main__":
    main(sys.argv[1:])
