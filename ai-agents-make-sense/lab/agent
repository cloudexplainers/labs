#!/usr/bin/env python3
"""Give Claude Code (headless) one request, and print every step of its loop.

  agent [--session NAME] [--no-tools] [--max-turns N] "request"

Works in bill-splitter/. Each model request is printed with the size of its context
(the tokens the model read), every tool it asked for, and a short summary of each result.
--session NAME  continue the session saved under NAME (or start one): same conversation
--no-tools      no tools at all: the model can only answer from what's in its context
--max-turns N   stop the loop after N turns
Nothing else is loaded: no user settings, no auto memory, no MCP servers. Permission mode
dontAsk: reading files and read-only commands run; edits are allowed; the only other command
allowed is the tests (python3 -m unittest). Anything else is refused, because nobody is
there to approve it. The full event stream of the last run is kept in .log/last.jsonl.
"""
import json, os, re, subprocess, sys, textwrap, uuid

here = os.path.dirname(os.path.abspath(__file__))
project = os.path.join(here, "bill-splitter")
args, flags, i = [], {}, 1
while i < len(sys.argv):
    a = sys.argv[i]
    if a in ("--session", "--max-turns"):
        flags[a] = sys.argv[i + 1]; i += 2
    elif a.startswith("--"):
        flags[a] = True; i += 1
    else:
        args.append(a); i += 1

tools = "" if "--no-tools" in flags else "Bash,Read,Edit,Write"
cmd = ["claude", "-p", " ".join(args), "--model", "sonnet",
       "--output-format", "stream-json", "--verbose",
       "--setting-sources", "project", "--strict-mcp-config",
       "--settings", json.dumps({"autoMemoryEnabled": False}),
       "--permission-mode", "dontAsk", "--tools", tools,
       "--append-system-prompt", "Answer in plain text, without Markdown."
       + ("" if tools else " You have no tools in this session.")]
if tools:
    cmd += ["--allowedTools", "Bash(python3 -m unittest*),Read,Edit,Write"]
if "--max-turns" in flags:
    cmd += ["--max-turns", flags["--max-turns"]]
sessions_file = os.path.join(here, ".log", "sessions.json")
os.makedirs(os.path.dirname(sessions_file), exist_ok=True)
sessions = json.load(open(sessions_file)) if os.path.exists(sessions_file) else {}
name = flags.get("--session")
if name and name in sessions:
    cmd += ["--resume", sessions[name]]
elif name:
    sessions[name] = str(uuid.uuid4())
    cmd += ["--session-id", sessions[name]]
    json.dump(sessions, open(sessions_file, "w"))

env = dict(os.environ, CLAUDE_CODE_DISABLE_AUTO_MEMORY="1")
proc = subprocess.run(cmd, cwd=project, env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL)
open(os.path.join(here, ".log", "last.jsonl"), "w").write(proc.stdout)

W = 62


def say(prefix, text, indent="  "):
    for n, para in enumerate(t for t in text.strip().split("\n") if t.strip()):
        for k, l in enumerate(textwrap.wrap(para, W - len(prefix))):
            print((prefix if n == 0 and k == 0 else indent + " " * (len(prefix) - len(indent))) + l)


def short(path):
    return os.path.relpath(path, project) if os.path.isabs(path) else path


def summary(tool, inp, res, is_error):
    text = res if isinstance(res, str) else "\n".join(b.get("text", "") for b in res if isinstance(b, dict))
    lines = [l for l in text.split("\n") if l.strip()]
    if "requires approval" in text or "denied" in text.lower() and is_error:
        return ["refused: not allowed"]
    if tool == "Bash":
        keep = [l.strip() for l in lines if l.startswith(("AssertionError", "FAILED", "OK", "Ran "))]
        if keep:
            return keep
        return [lines[0].strip()[:W - 10] + (f"  (+{len(lines) - 1} lines)" if len(lines) > 1 else "")] if lines else ["(no output)"]
    if tool == "Read":
        return [f"contents of {short(inp['file_path'])}"]
    if tool == "Edit":
        return [f"- {inp['old_string'].strip()}", f"+ {inp['new_string'].strip()}"]
    if tool == "Write":
        return [f"wrote {short(inp['file_path'])}"]
    return [lines[0][:W] if lines else "(empty)"]


requests, order, pending, result = {}, [], {}, {}
for line in proc.stdout.splitlines():
    ev = json.loads(line)
    if ev.get("type") == "assistant":
        m = ev["message"]
        if m["id"] not in requests:
            u = m["usage"]
            requests[m["id"]] = {"tokens": u["input_tokens"] + u.get("cache_creation_input_tokens", 0)
                                 + u.get("cache_read_input_tokens", 0), "items": []}
            order.append(m["id"])
        for b in m["content"]:
            if b["type"] == "text" and b["text"].strip():
                requests[m["id"]]["items"].append(("text", b["text"]))
            elif b["type"] == "tool_use":
                requests[m["id"]]["items"].append(("tool", b))
    elif ev.get("type") == "user":
        for b in ev["message"]["content"]:
            if isinstance(b, dict) and b.get("type") == "tool_result":
                pending[b["tool_use_id"]] = (b.get("content", ""), b.get("is_error", False))
    elif ev.get("type") == "result":
        result = ev

for n, mid in enumerate(order, 1):
    r = requests[mid]
    print(f"── request {n} · model reads {r['tokens']:,} tokens")
    last = n == len(order)
    for kind, x in r["items"]:
        if kind == "text":
            say("answer: " if last and result.get("subtype") == "success" else "model: ", x)
        else:
            inp = x["input"]
            shown = {"Bash": lambda: inp["command"], "Read": lambda: short(inp["file_path"]),
                     "Edit": lambda: short(inp["file_path"]), "Write": lambda: short(inp["file_path"])}
            print(f"model asks: {x['name']}  {shown.get(x['name'], lambda: json.dumps(inp))()}")
            if x["id"] in pending:
                for l in summary(x["name"], inp, *pending[x["id"]]):
                    print(f"  ← {l}")
total = sum(requests[m]["tokens"] for m in order)
why = {"success": "answered", "error_max_turns": "hit the --max-turns limit"}.get(result.get("subtype"), result.get("subtype"))
print(f"({len(order)} request{'s' if len(order) != 1 else ''} · {total:,} tokens read in all · stopped: {why})")
