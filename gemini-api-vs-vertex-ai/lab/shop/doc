#!/usr/bin/env python3
"""Print the text around a phrase on one of Google's docs pages: ./doc URL 'phrase' [chars]."""
import html, re, sys, urllib.request

url, phrase = sys.argv[1], sys.argv[2]
n = int(sys.argv[3]) if len(sys.argv) > 3 else 200
page = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "curl/8"}), timeout=60).read()
text = re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", page.decode("utf-8", "replace"))))
i = text.find(phrase)
if i < 0:
    sys.exit(f"not found: {phrase}")
print(text[max(0, i - n // 4):i + n].strip())
