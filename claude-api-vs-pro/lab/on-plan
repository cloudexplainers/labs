#!/usr/bin/env python3
"""Send the same request as summarize.py through Claude Code (headless), signed in with a Claude plan.

  on-plan EMAIL_FILE

Same model, same instructions, same email. Claude Code runs with nothing else loaded (no tools, no settings,
no memory, no MCP servers) and without any API key in its environment, so it uses the plan's login.
Prints the summary, the tokens Claude Code reported for the request, and how Claude Code is signed in
(only the sign-in method and plan type: no names, emails or ids).
"""
import json, os, subprocess, sys

email = open(sys.argv[1]).read()
env = {k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
auth = json.loads(subprocess.run(["claude", "auth", "status", "--json"], env=env, capture_output=True,
                                 text=True).stdout)
cmd = ["claude", "-p", "Summarize in one sentence:\n" + email, "--model", "sonnet", "--output-format", "json",
       "--system-prompt", "You summarize customer emails for a small coffee shop.",
       "--tools", "", "--setting-sources", "project", "--strict-mcp-config",
       "--settings", json.dumps({"autoMemoryEnabled": False})]
r = json.loads(subprocess.run(cmd, env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout)
u = r["usage"]
tokens_in = u["input_tokens"] + u.get("cache_creation_input_tokens", 0) + u.get("cache_read_input_tokens", 0)
os.makedirs(".log", exist_ok=True)
json.dump({"model": list(r["modelUsage"])[0], "in": tokens_in, "out": u["output_tokens"]},
          open(".log/on-plan.json", "w"))
print(r["result"].strip())
print(f"(tokens in: {tokens_in:,} · tokens out: {u['output_tokens']:,})")
print(f"(signed in with: {auth['authMethod']} · plan: {auth.get('subscriptionType', '?')})")
