#!/usr/bin/env python3
"""The request John's app sends when Jen's access token runs out: trade the refresh token for new tokens. Uses
~/flow/refresh unless TOKEN is set; saves the new refresh token it gets back."""
import os
from pathlib import Path
import requests

flow = Path.home() / "flow"
token = os.environ.get("TOKEN") or (flow / "refresh").read_text()
r = requests.post("https://id.shuttle.test/realms/shuttle/protocol/openid-connect/token",
                  data={"grant_type": "refresh_token", "refresh_token": token},
                  auth=("shuttle-app", (Path.home() / ".shuttle-secret").read_text().strip()))
if r.ok:
    t = r.json()
    (flow / "refresh").write_text(t["refresh_token"])
    print(f"{r.status_code} OK  new access_token: {t['access_token'][:10]}... (expires in {t['expires_in']} s)")
    print(f"        new refresh_token: {t['refresh_token'][:10]}... (saved in ~/flow/refresh)")
else:
    print(r.status_code, r.text)
