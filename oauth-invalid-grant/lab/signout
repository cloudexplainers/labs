#!/usr/bin/env python3
"""What John's app sends when Jen taps "Sign out": ends her session at Shuttle ID."""
from pathlib import Path
import requests

r = requests.post("https://id.shuttle.test/realms/shuttle/protocol/openid-connect/logout",
                  data={"refresh_token": (Path.home() / "flow" / "refresh").read_text()},
                  auth=("shuttle-app", (Path.home() / ".shuttle-secret").read_text().strip()))
print(r.status_code, "signed out" if r.status_code == 204 else r.text)
