# One of the lab's two web sites (shop.test, other-site.test): Python's own HTTPS server plus py_webauthn.
FROM python:3.12-slim
RUN pip install --no-cache-dir webauthn==2.7.1 && apt-get update -qq && apt-get install -y -qq jq >/dev/null \
 && rm -rf /var/lib/apt/lists/* && useradd -m -s /bin/bash ana
COPY site.py /srv/site.py
WORKDIR /srv
CMD ["python3", "-u", "/srv/site.py"]
