#!/usr/bin/env python3
"""shop-token --again: send the shop's last one-time code to Kettle ID a second time (it was already used)."""
import os
import sys

import requests

OIDC = "https://id.test/realms/kettle/protocol/openid-connect"
CA = "/etc/ssl/certs/ca-certificates.crt"
if sys.argv[1:] != ["--again"]:
    sys.exit("usage: shop-token --again")
code = open("/srv/data/last_code").read()
verifier = open("/srv/data/last_verifier").read()
print(f"POST {OIDC}/token")
print(f"  code {code[:6]}... (already used once), client secret, PKCE verifier")
r = requests.post(OIDC + "/token", auth=("tea-shop", os.environ.get("CLIENT_SECRET", "")), verify=CA, data={
    "grant_type": "authorization_code", "code": code, "redirect_uri": "https://shop.test/callback",
    "code_verifier": verifier})
print(f"-> {r.status_code} {r.text}")
