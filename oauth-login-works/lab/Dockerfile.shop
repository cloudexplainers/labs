# Ana's Tea Shop: a small web app with a "Sign in with Kettle ID" button (OAuth 2.0 + OpenID Connect).
FROM python:3.12-slim
RUN pip install --no-cache-dir "pyjwt[crypto]==2.10.1" requests==2.32.5 \
 && apt-get update -qq && apt-get install -y -qq jq curl >/dev/null && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash ana && mkdir -p /srv/log /srv/data && chown ana /srv/log /srv/data
COPY shop.py /srv/shop.py
COPY shop-token shop-api /usr/local/bin/
WORKDIR /srv
CMD ["python3", "-u", "/srv/shop.py"]
