#!/usr/bin/env python3
"""browser URL: open a page in a real Chromium (Playwright's build) and print what came back.

Chromium checks the certificate with its own verifier and trusts the roots in ~/.pki/nssdb, like Chrome on Linux.
"""
import sys

from playwright.sync_api import sync_playwright

url = sys.argv[1]
with sync_playwright() as p:
    b = p.chromium.launch()
    page = b.new_page()
    try:
        r = page.goto(url, timeout=20000)
        print(f"browser: {r.status} {page.title()}")
    except Exception as e:
        print("browser:", str(e).splitlines()[0])
    b.close()
