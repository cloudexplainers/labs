#!/bin/bash
# ./ask "question": Claude Code answers one question, with no chat window,
# using only this folder's MCP servers (.mcp.json). search_cars may run;
# any other tool must be allowed first: ./ask --allow mark_sold "question"
allow="mcp__car-lot__search_cars"
if [ "$1" = "--allow" ]; then allow="$allow mcp__car-lot__$2"; shift 2; fi
claude -p "$1" --mcp-config .mcp.json --strict-mcp-config \
  --setting-sources project --allowedTools $allow \
  --output-format stream-json --verbose </dev/null | python3 show_calls.py
