#!/bin/sh
# How busy this server's one CPU core was over the next N seconds (default 3), from its own cgroup counter.
s=${1:-3}
a=$(awk '/^usage_usec/ {print $2}' /sys/fs/cgroup/cpu.stat); sleep "$s"
b=$(awk '/^usage_usec/ {print $2}' /sys/fs/cgroup/cpu.stat)
echo "CPU busy: $(( (b - a) / (s * 10000) ))% of 1 core over the last $s s"
