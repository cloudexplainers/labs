# Ana's laptop: Ubuntu 24.04 with curl, jq and a real Chromium (Playwright's build), driven by `browser`.
FROM mcr.microsoft.com/playwright/python:v1.55.0-noble
RUN pip install --no-cache-dir --break-system-packages playwright==1.55.0 \
 && apt-get update -qq && apt-get install -y -qq curl jq >/dev/null && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash ana
COPY browser /usr/local/bin/browser
