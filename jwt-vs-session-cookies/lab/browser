#!/usr/bin/env python3
"""A real Chromium (Playwright's build), driven from the command line (lab only).

  browser URL    open the shop's page, whose own script logs in both ways (a session cookie, and a token kept in
                 localStorage); then run, inside the page, what any script on that page could run, and list the
                 cookies the browser itself holds.
"""
import json
import sys

from playwright.sync_api import sync_playwright


def main(url):
    with sync_playwright() as p:
        b = p.chromium.launch()
        ctx = b.new_context()
        page = ctx.new_page()
        print(f"browser: opened {url}")
        page.goto(url)
        page.wait_for_function("window.result !== undefined", timeout=20000)
        print(f"page:    {page.evaluate('window.result')}")
        print("a script on the page can read:")
        print(f"  document.cookie                 {json.dumps(page.evaluate('document.cookie'))}")
        tok = page.evaluate("localStorage.getItem('token')")
        print(f"  localStorage.getItem('token')   \"{tok[:24]}...\" ({len(tok)} characters)")
        st = page.evaluate("fetch('/orders').then(r => r.status)")
        print(f"  fetch('/orders')                {st}, with no code adding the cookie")
        print("the browser's own cookie store:")
        for c in ctx.cookies():
            flags = " ".join(f for f, on in (("HttpOnly", c["httpOnly"]), ("Secure", c["secure"])) if on)
            print(f"  {c['name']}  domain {c['domain'].lstrip('.')}  {flags}  SameSite={c['sameSite']}")
        b.close()


if __name__ == "__main__":
    main(sys.argv[1])
